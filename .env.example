# ====================================================
# JobTrack Environment Configuration
# Copy this file to backend/.env and customize secrets
# ====================================================

# Backend Server Port
PORT=5000

# JSON Web Token Secret Key (Change to a long random secret in production)
JWT_SECRET=jobtrack_super_secret_jwt_key_2026_change_in_production

# Initial Administrator Account Credentials
ADMIN_EMAIL=admin@jobtrack.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=JobTrack Administrator
